{
  "name": "clik-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/pvydro/clik-engine.git"
  },
  "version": "1.1.0",
  "type": "module",
  "main": "dist/clik-engine.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/clik-engine.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src",
    "docs": "typedoc"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.18",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.2"
  }
}
